# Nach .env kopieren und Key eintragen. Die .env ist gitignored.
# Key gibt's über die GWDG Academic Cloud (Chat AI / SAIA):
#   Doku:      https://docs.hpc.gwdg.de/services/saia/index.html
#   Modelle:   https://docs.hpc.gwdg.de/services/chat-ai/models/index.html
#
# Die API ist OpenAI-kompatibel, wir benutzen also den openai-Client mit
# geänderter base_url – siehe magda/config.py.

CHAT_AI_API_KEY=

# Nur setzen, wenn vom Default abgewichen werden soll:
# CHAT_AI_BASE_URL=https://chat-ai.academiccloud.de/v1
# CHAT_AI_VISION_MODEL=

# Welche Modelle der Key freischaltet, listet:
#   curl -H "Authorization: Bearer $CHAT_AI_API_KEY" \
#        https://chat-ai.academiccloud.de/v1/models
# Achtung: die Liste ändert sich, Modelle verschwinden auch wieder.
